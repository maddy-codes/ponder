{"id":"cheap:x08","prompt_preview":"Write a Python function `check_transfer(balance, amount)` that returns the string 'ok' when amount is posit...","difficulty":0.1,"stakes":0.1,"budget":"cheap","matched_rule":null,"rule_reason":null,"rule_id":"ponder-cheap-answer-only","strategy":"cheap","samples":[{"status":"done","tokens":144,"gpu_seconds":3.1601}],"sandbox_ran":false,"sandbox_passed":null,"guardrails":[],"guardrail_verdicts":[],"guardrail_escalated":false,"guardrail_blocked":false,"answer":"```python\ndef check_transfer(balance, amount):\n    return 'ok' if amount > 0 and amount <= balance else 'rejected'\n```","correct":true,"latency_ms":9061,"total_tokens":144,"total_gpu_seconds":3.1601,"logfire_trace_url":null,"status":"done","ts":1789831027.085723}
{"id":"cheap:x06","prompt_preview":"Write a Python function `binary_search(xs, target)` over a sorted list that returns the index of target or ...","difficulty":0.1,"stakes":0.1,"budget":"cheap","matched_rule":null,"rule_reason":null,"rule_id":"ponder-cheap-answer-only","strategy":"cheap","samples":[{"status":"done","tokens":265,"gpu_seconds":16.075}],"sandbox_ran":false,"sandbox_passed":null,"guardrails":[],"guardrail_verdicts":[],"guardrail_escalated":false,"guardrail_blocked":false,"answer":"def binary_search(xs, target):\n    lo, hi = 0, len(xs) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if xs[mid] == target:\n            return mid\n        elif xs[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return -1","correct":true,"latency_ms":21642,"total_tokens":265,"total_gpu_seconds":16.075,"logfire_trace_url":null,"status":"done","ts":1789831028.8545039}
{"id":"cheap:x05","prompt_preview":"Write a Python function `median(xs)` returning the median of a list of numbers, averaging the middle two fo...","difficulty":0.1,"stakes":0.1,"budget":"cheap","matched_rule":null,"rule_reason":null,"rule_id":"ponder-cheap-answer-only","strategy":"cheap","samples":[{"status":"done","tokens":253,"gpu_seconds":21.7644}],"sandbox_ran":false,"sandbox_passed":null,"guardrails":[],"guardrail_verdicts":[],"guardrail_escalated":false,"guardrail_blocked":false,"answer":"def median(xs):\n    if not xs:\n        raise ValueError(\"median of empty list\")\n    ys = sorted(xs)\n    n = len(ys)\n    mid = n // 2\n    if n % 2:\n        return ys[mid]\n    return (ys[mid - 1] + ys[mid]) / 2","correct":true,"latency_ms":27632,"total_tokens":253,"total_gpu_seconds":21.7644,"logfire_trace_url":null,"status":"done","ts":1789831030.322604}
{"id":"cheap:x07","prompt_preview":"Write a Python function `apply_vat(net, rate)` returning the gross amount rounded to two decimal places, ro...","difficulty":0.6,"stakes":0.3,"budget":"cheap","matched_rule":null,"rule_reason":null,"rule_id":"ponder-cheap-answer-only","strategy":"cheap","samples":[{"status":"done","tokens":940,"gpu_seconds":12.4358}],"sandbox_ran":false,"sandbox_passed":null,"guardrails":[],"guardrail_verdicts":[],"guardrail_escalated":false,"guardrail_blocked":false,"answer":"from decimal import Decimal, ROUND_HALF_UP\n\ndef apply_vat(net, rate):\n    gross = Decimal(str(net)) * (Decimal('1') + Decimal(str(rate)))\n    return float(gross.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP))","correct":true,"latency_ms":21023,"total_tokens":940,"total_gpu_seconds":12.4358,"logfire_trace_url":null,"status":"done","ts":1789831032.2123039}
