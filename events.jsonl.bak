{"id":"cheap:x04","prompt_preview":"Write a Python function `parse_amount(s)` that converts a string like '£1,234.50' into the float 1234.5. It...","difficulty":0.2,"stakes":0.2,"budget":"cheap","matched_rule":null,"rule_reason":null,"rule_id":"ponder-cheap-answer-only","strategy":"cheap","samples":[{"status":"done","tokens":327,"gpu_seconds":24.684}],"sandbox_ran":false,"sandbox_passed":null,"guardrails":[],"guardrail_verdicts":[],"guardrail_escalated":false,"guardrail_blocked":false,"answer":"def parse_amount(s):\n    if not isinstance(s, str) or not s.strip():\n        raise ValueError(\"Amount cannot be empty or blank\")\n    return float(s.replace('£', '').replace(',', '').strip())","correct":true,"latency_ms":30578,"total_tokens":327,"total_gpu_seconds":24.684,"logfire_trace_url":null,"status":"done","ts":1789831023.798205}
