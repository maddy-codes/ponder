# ---- mode -------------------------------------------------------------
# stub = no credentials needed, deterministic fake worker model
# live = real Gateway -> Modal calls
PONDER_MODE=stub

# ---- Pydantic AI Gateway + Logfire ------------------------------------
LOGFIRE_TOKEN=
# Your Logfire project's live view, e.g. https://logfire-eu.pydantic.dev/<org>/<project>
LOGFIRE_PROJECT_URL=
PYDANTIC_AI_GATEWAY_API_KEY=
PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway.pydantic.dev/v1
# The Gateway model id that maps to your BYOK Modal provider
GATEWAY_MODEL=modal/ponder-worker
# Custom Gateway rule ids (must be rules YOU created, not the built-in warm-up)
GATEWAY_RULE_CHEAP=ponder-cheap-answer-only
GATEWAY_RULE_DEEP=ponder-deep-reason

# ---- Modal ------------------------------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODEL_ENDPOINT_URL=

# ---- Convex -----------------------------------------------------------
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=

# ---- optional triage judge -------------------------------------------
GEMINI_API_KEY=
