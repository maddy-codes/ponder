# ---- mode -------------------------------------------------------------
# stub = no credentials needed, deterministic fake worker model
# live = real Gateway -> Modal calls
PONDER_MODE=stub

# ---- Pydantic AI Gateway + Logfire ------------------------------------
LOGFIRE_TOKEN=
# Your Logfire project's live view, e.g. https://logfire-eu.pydantic.dev/<org>/<project>
LOGFIRE_PROJECT_URL=
PYDANTIC_AI_GATEWAY_API_KEY=
PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway.pydantic.dev/v1
# The BYOK provider name you created in the Gateway console (step 5 of the demo repo).
GATEWAY_ROUTE=modal
# A Gateway Optimization targets a ROUTE, so effort is switched by selecting one.
# Point these at two BYOK providers fronting the SAME Modal endpoint, each with a
# different optimization installed. Leave blank to use the single GATEWAY_ROUTE.
GATEWAY_ROUTE_CHEAP=
GATEWAY_ROUTE_DEEP=
# The Hugging Face repo id your Modal endpoint serves, e.g. google/gemma-4-31B-it.
# Must match the --model you passed to `modal endpoint create`.
GATEWAY_MODEL=
# Custom Gateway rule ids (must be rules YOU created, not the built-in warm-up)
GATEWAY_RULE_CHEAP=ponder-cheap-answer-only
GATEWAY_RULE_DEEP=ponder-deep-reason
# Also set the served model's OWN reasoning parameter on the deep path. Set to 0 if
# your endpoint rejects reasoning_effort / enable_thinking.
PONDER_NATIVE_EFFORT=1

# ---- Modal ------------------------------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODEL_ENDPOINT_URL=
# GPU functions need a payment method on the Modal workspace. Set to 0 to deploy
# the fan-out and sandbox (both CPU) without the vLLM endpoint.
PONDER_SERVE_GPU=1

# ---- Convex -----------------------------------------------------------
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=

# ---- optional triage judge -------------------------------------------
GEMINI_API_KEY=
# gemini-2.5-flash is retired for new keys; 3.6-flash is the current judge.
GEMINI_MODEL=gemini-3.6-flash
